              "    pm.expect(response.length).to.be.greaterThan(0);\r",
              "});\r",
              "\r",
              "pm.test(\"Each comment contains required fields\", function () {\r",
              "    const requiredFields = [\r",
              "        \"postId\",\r",
              "        \"id\",\r",
              "        \"name\",\r",
              "        \"email\",\r",
              "        \"body\"\r",
              "    ];\r",
              "\r",
              "    response.forEach(function (comment) {\r",
              "        requiredFields.forEach(function (field) {\r",
              "            pm.expect(comment).to.have.property(field);\r",
              "        });\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test(\"Comment fields have correct data types\", function () {\r",
              "    response.forEach(function (comment) {\r",
              "        pm.expect(comment.postId).to.be.a(\"number\");\r",
              "        pm.expect(comment.id).to.be.a(\"number\");\r",
              "        pm.expect(comment.name).to.be.a(\"string\");\r",
              "        pm.expect(comment.email).to.be.a(\"string\");\r",
              "        pm.expect(comment.body).to.be.a(\"string\");\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test(\"Comments belong to post 1\", function () {\r",
              "    response.forEach(function (comment) {\r",
              "        pm.expect(comment.postId).to.eql(1);\r",
              "    });\r",
              "});"
