    {
      "name": "getPostById",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const response = pm.response.json();\r",
              "\r",
              "pm.test(\"Response is an array containing one post\", function () {\r",
              "    pm.expect(response).to.be.an(\"array\");\r",
              "    pm.expect(response).to.have.lengthOf(1);\r",
              "});\r",
              "\r",
              "pm.test(\"Returned post ID matches the query parameter\", function () {\r",
              "    const postId = Number(pm.request.url.query.get(\"id\"));\r",
              "\r",
              "    pm.expect(Number.isNaN(postId)).to.be.false;\r",
              "    pm.expect(response[0].id).to.eql(postId);\r",
              "});\r",
              "\r",
              "pm.test(\"Post contains required fields\", function () {\r",
              "    const post = response[0];\r",
              "\r",
              "    pm.expect(post).to.have.property(\"userId\");\r",
              "    pm.expect(post).to.have.property(\"id\");\r",
              "    pm.expect(post).to.have.property(\"title\");\r",
              "    pm.expect(post).to.have.property(\"body\");\r",
              "});\r",
              "\r",
              "pm.test(\"Post fields have the correct data types\", function () {\r",
              "    const post = response[0];\r",
              "\r",
              "    pm.expect(post.userId).to.be.a(\"number\");\r",
              "    pm.expect(post.id).to.be.a(\"number\");\r",
              "    pm.expect(post.title).to.be.a(\"string\");\r",
              "    pm.expect(post.body).to.be.a(\"string\");\r",
              "});\r",
              "\r",
              "pm.test(\"Post title and body are not empty\", function () {\r",
              "    const post = response[0];\r",
              "\r",
              "    pm.expect(post.title.trim()).to.not.equal(\"\");\r",
              "    pm.expect(post.body.trim()).to.not.equal(\"\");\r",
              "});\r",
              ""
            ],
